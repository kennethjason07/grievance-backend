# Application Settings
APP_NAME="Government Grievance Tracking System"
APP_ENV="development"
DEBUG=True

# Database Configuration (PostgreSQL with Psycopg 3 driver)
DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/grievance_db"

# Security
SECRET_KEY="development-secret-key-change-in-production-minimum-32-characters"

# JWT Configuration
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM="HS256"

# CORS Allowed Origins (Comma-separated list or JSON array)
CORS_ORIGINS="http://localhost:3000,http://localhost:8000"

# Document Storage Settings
UPLOAD_DIR="uploads"
MAX_UPLOAD_SIZE_BYTES=26214400 # 25 MB

# OCR Settings (Tesseract OCR Engine - Stage 1)
# Windows example: TESSERACT_CMD="C:\\Program Files\\Tesseract-OCR\\tesseract.exe"
# Linux example:   TESSERACT_CMD="/usr/bin/tesseract"
# Leave empty/commented out if tesseract is in your system PATH
TESSERACT_CMD=""

# Windows example: TESSDATA_PREFIX="C:\\Program Files\\Tesseract-OCR\\tessdata"
# Linux example:   TESSDATA_PREFIX="/usr/share/tesseract-ocr/5/tessdata"
# Leave empty/commented out if standard tessdata folder is used
TESSDATA_PREFIX=""

# Default language models to load during OCR: English + Kannada
OCR_DEFAULT_LANGUAGES="eng+kan"
MAX_OCR_PAGES=20
MAX_RENDER_DPI=200
OCR_TIMEOUT_SECONDS=120

# Translation Settings (Stage 2)
TRANSLATION_PROVIDER="mock"
INDICTRANS2_MODEL_PATH=""
TRANSLATION_MAX_CHUNK_CHARS=1500
TRANSLATION_TIMEOUT_SECONDS=60
